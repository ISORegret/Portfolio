node_modules

# Next.js build output (delete this folder if CSS stops loading in dev)
.next
out

# Local env — never commit (copy from .env.example)
.env*.local

# TypeScript incremental build cache
*.tsbuildinfo

# Build-time image variants; originals remain in public/gallery.
public/prepared/

# Decoded mock stand-in images (binary). The committed .b64 sources in
# public/mock/ are decoded by scripts/decode-mock-images.mjs at build time.
public/mock/*.jpg
public/mock/*.jpeg
public/mock/*.webp
